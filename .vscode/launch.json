{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Запустити iFranko Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}/server.js",
            "serverReadyAction": {
                "pattern": "Сервер iFranko працює на (http://localhost:\\d+)",
                "action": "openExternally"
            }
        }
    ]
}